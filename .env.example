# Copy to .env and fill in. .env is gitignored -- never commit real values.

# The dedicated Agentverse identity for THIS adapter only. Generate with
# `python scripts/generate_identity.py` -- do not reuse any existing OCD
# signing key, wallet key, API credential, or the Technocore DID.
AGENTVERSE_AGENT_SEED=

# Only needed to run scripts/register_agentverse.py (operator-run, requires
# an Agentverse.ai account). Not needed to run the adapter itself.
AGENTVERSE_API_KEY=

# Defaults to the real, live, public OCD MCP surface -- override only for
# local testing against a different environment.
OCD_PUBLIC_MCP_URL=https://mcp.onchaindiligence.com/public/mcp
